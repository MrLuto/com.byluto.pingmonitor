{
  "name": {
    "en": "Ping Device",
    "nl": "Ping apparaat"
  },
  "class": "sensor",
  "capabilities": [
    "onoff",
    "ping_status"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "manual_add",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "manual_add",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices",
      "navigation": {
        "prev": "list_devices"
      }
    }
  ],
  "settings": [
    {
      "id": "host",
      "type": "text",
      "label": {
        "en": "Host or IP",
        "nl": "Host of IP"
      },
      "hint": {
        "en": "For example: 192.168.1.10 or nas.local",
        "nl": "Bijvoorbeeld: 192.168.1.10 of nas.local"
      },
      "value": "8.8.8.8"
    },
    {
      "id": "interval",
      "type": "number",
      "label": {
        "en": "Ping interval (seconds)",
        "nl": "Ping-interval (seconden)"
      },
      "hint": {
        "en": "How often the device is pinged.",
        "nl": "Hoe vaak het apparaat wordt gepingd."
      },
      "value": 30,
      "attr": {
        "min": 5,
        "max": 3600,
        "step": 1
      }
    },
    {
      "id": "timeout",
      "type": "number",
      "label": {
        "en": "Ping timeout (ms)",
        "nl": "Ping-timeout (ms)"
      },
      "hint": {
        "en": "Maximum wait time per ping.",
        "nl": "Maximale wachttijd per ping."
      },
      "value": 2000,
      "attr": {
        "min": 500,
        "max": 10000,
        "step": 100
      }
    },
    {
      "id": "tcp_port",
      "type": "number",
      "label": {
        "en": "TCP port",
        "nl": "TCP-poort"
      },
      "hint": {
        "en": "TCP port used to check whether the device is reachable. Example: 443, 80, 22",
        "nl": "TCP-poort die wordt gebruikt om te controleren of het apparaat bereikbaar is. Bijvoorbeeld: 443, 80, 22"
      },
      "value": 443,
      "attr": {
        "min": 1,
        "max": 65535,
        "step": 1
      }
    }
  ],
  "capabilitiesOptions": {
    "onoff": {
      "setable": true,
      "title": {
        "en": "Ping now",
        "nl": "Ping nu"
      }
    }
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  }
}
